---
import Layout from "../layouts/Layout.astro";

const items = [
  {
    year: 2026,
    title: "Dikey İnişli Roket Yarışması",
    variant: 1,
    description:
        "Gelişmiş kontrol algoritmaları, hassas iniş manevraları ve yeni nesil itki sistemi üzerine çalışmaların sürdüğü aktif yarışma sürecidir. Roketimiz, otonom iniş kabiliyetini artırmak ve uçuş stabilitesini optimize etmek amacıyla sürekli olarak test ve iyileştirme aşamasındadır.",
  },
  {
    year: 2026,
    title: "Dikey İnişli Roket Yarışması",
    variant: 2,
    description:
        "Gelişmiş kontrol algoritmaları, hassas iniş manevraları ve yeni nesil itki sistemi üzerine çalışmaların sürdüğü aktif yarışma sürecidir. Roketimiz, otonom iniş kabiliyetini artırmak ve uçuş stabilitesini optimize etmek amacıyla sürekli olarak test ve iyileştirme aşamasındadır.",
  },
  {
    year: 2026,
    title: "İnsansız Kara Aracı Yarışması",
    description:
        "Otonom sürüş algoritmaları, sensör füzyonu ve gerçek zamanlı kontrol sistemleri üzerine geliştirmelerin devam ettiği projedir. Araç, farklı arazi koşullarında yüksek doğrulukla hareket edebilmesi için yazılım ve donanım entegrasyonu açısından aktif olarak geliştirilmektedir.",
  },
  {
    year: 2026,
    title: "İnsansız Hava Aracı Yarışması",
    description:
        "Uçuş kontrol sistemleri, görev planlama ve otonom navigasyon algoritmaları üzerinde yoğunlaşılan aktif yarışma sürecidir. Sistem, stabil uçuş performansı ve görev bazlı otonomi yeteneklerini artırmak amacıyla sürekli test edilmektedir.",
  },
  {
    year: 2026,
    title: "Biyoteknoloji İnovasyon Yarışması",
    description:
        "İleri mühendislik ve biyoteknoloji alanlarının kesişiminde yer alan yenilikçi çözüm geliştirme sürecidir. Proje, sürdürülebilirlik ve uygulama odaklı teknolojiler üretmeye yönelik araştırma ve prototipleme aşamasında ilerlemektedir.",
    bordered: true,
  },
  {
    year: 2025,
    title: "Dikey İnişli Roket Yarışması",
    description:
        "2025 yılında geliştirilen ikinci nesil dikey iniş roketimiz ile Teknofest yarışmasına katılım sağlandı. Gelişmiş kontrol algoritmaları ve yeni itki sistemiyle başarılı test uçuşları gerçekleştirildi.",
    highlighted: true,
  },
];

const renderTitle = (item: typeof items[0]) =>
    `${item.year} – ${item.title}${item.variant ? ` (${item.variant})` : ""}`;
---

<Layout title="Ekibimiz" description="Taragay Ekibi">
  <section class="flex justify-center items-center bg-black text-white font-nasa text-center">
    <div class="flex flex-col items-center pt-40 pb-20 px-6 w-full max-w-6xl">

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 w-full">
        {items.slice(0, 5).map((item, i) => (
            <div
                class={`px-10 py-5 ${
                    i === 0 ? "halfborder-bl" :
                        i === 4 ? "halfborder-br" : ""
                }`}
            >
              <h2 class="text-2xl font-semibold mb-2">
                {renderTitle(item)}
              </h2>
              <p class="text-gray-300 text-sm leading-relaxed">
                {item.description}
              </p>
            </div>
        ))}
      </div>

      <div class="w-[80%] border-x-2 border-emerald-800 px-10 py-5 mt-10">
        <h2 class="text-2xl font-semibold mb-2">
          {renderTitle(items[5])}
        </h2>
        <p class="text-gray-300 text-sm leading-relaxed">
          {items[5].description}
        </p>
      </div>

    </div>
  </section>
</Layout>